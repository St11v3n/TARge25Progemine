@model TARge25Shop.Models.Email.EmailViewModel

<h1>Send Email</h1>

<div >
    <form method="post" enctype="multipart/form-data">

        <div class="form-group row">
            <label asp-for="To" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-5">
                <input asp-for="To" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Subject" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-5">
                <input asp-for="Subject" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Body" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-5">
                <input asp-for="Body" class="form-control" />
            </div>

            <div class="form-group row">
                <label asp-for="Attachments" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-5">
                    <input asp-for="Attachments" class="form-control" multiple="multipl" type="file" />
                </div>
            </div>
        </div>

        <input asp-action="sendEmail" asp-controller="email" type="submit" value="Send Email" class="btn btn-primary" />
    </form>
</div>