@model IEnumerable<TARge25Shop.Models.Kindergarten.KindergartenIndexViewModel>

<div>
    <a asp-action="create" asp-controller="kindergarten" id="CreateInIndex" type="submit" class="btn btn-primary">Create</a>
</div>

@{
    short rowNumber = 1;
}


<div class="h1">
    Kindergarten
</div>
<form method="get">
    <table id="IndexTable" class="table table-hover">
        <thead>
            <tr>
                <th id="IndexRowNumberColumn" scope="col">Nr</th>
                <th id="IndexGroupNameColumn" scope="col">GroupName</th>
                <th id="IndexChildrenCountColumn" scope="col">ChildrenCount</th>
                <th id="IndexBuiltDateColumn" scope="col">Built Date</th>
                <th id="IndexKindergartenNameColumn" scope="col">KindergartenName</th>
                <th id="IndexTeacherNameColumn" scope="col">TeacherName</th>
                <th id="IndexActionsColumn" scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kindergarten in Model)
            {
                <tr>
                    <td id="IndexRowNumberKindergarten">@rowNumber</td>
                    <td id="IndexGroupNameKindergarten">@kindergarten.GroupName</td>
                    <td id="IndexChildrenCountKindergarten">@kindergarten.ChildrenCount</td>
                    <td id="IndexBuiltDateKindergarten">@kindergarten.CreatedAt</td>
                    <td id="IndexKindergartenNameKindergarten">@kindergarten.KindergartenName</td>
                    <td id="IndexTeacherNameKindergarten">@kindergarten.TeacherName</td>
                    <td id="IndexActionsKindergarten">

                        <span id="IndexKindergartenId" hidden>@kindergarten.Id</span>
                        <a id="IndexKindergartenDetails" asp-action="details" asp-controller="kindergarten" asp-route-id="@kindergarten.Id" class="btn btn-primary">Details</a>
                        <a id="IndexKindergartenUpdate" asp-action="update" asp-controller="kindergarten" asp-route-id="@kindergarten.Id" class="btn btn-primary">Update</a>
                        <a id="IndexKindergartenDelete" asp-action="delete" asp-controller="kindergarten" asp-route-id="@kindergarten.Id" class="btn btn-outline-danger">Delete</a>
                    </td>
                </tr>
                rowNumber += 1;
            }
        </tbody>
    </table>
</form>