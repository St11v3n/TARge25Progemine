@model TARge25Shop.Models.Kindergarten.KindergartenCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>
        Update
    </h1>
}
else
{
    <h1>
        Create
    </h1>
}

<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="KindergartenName" id="CU_KindergartenNameEntryKindergarten" class="form-control" />

        </div>
    </div>

    <div class="form-group row">
        <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="GroupName" id="CU_GroupNameEntryKindergarten" class="form-control" />

        </div>
    </div>

    <div class="form-group row">
        <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="TeacherName" id="CU_TeacherNameEntryKindergarten" class="form-control" />

        </div>
    </div>

    <div class="form-group row">
        <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ChildrenCount" id="CU_ChildrenCountEntryKindergarten" class="form-control" />

        </div>
    </div>

    

    

    <div class="form-group row">
        <label asp-for="Files" class="control-label"></label>
        <div class="col-sm-5">
            <div class="custom-file">
                <input class="form-control" id="CU_FilesEntryKindergarten" asp-for="Files" multiple type="file" class="form-control" />
            </div>
        </div>
    </div>

    <div>
        @foreach (var image in Model.Image)
        {
            <partial name="_Images" model="image" />
            <input asp-action="removeImage" asp-controller="Kindergarten" asp-route-imageId="@image.ImageId"
                   type="submit" class="btn btn-danger" value="Remove Image" />
        }
    </div>

    <hr />
    <br />


    @if (Model.Id.HasValue)
    {
        <input asp-action="update" asp-controller="kindergarten" id="CU_UpdateKindergarten" type="submit" class="btn btn-success" value="Update" />
    }
    else
    {
        <input asp-action="create" asp-controller="kindergarten" id="CU_CreateKindergarten" type="submit" class="btn btn-success" value="Create" />
    }

    <a asp-action="Index" asp-controller="kindergarten" id="CU_Back" class="btn btn-secondary">Back To List</a>
</form>