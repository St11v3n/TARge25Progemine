@model TARge25Shop.Models.Account.ResetPasswordViewModel


peab tegema resetPassword vm

token ja email on peidus

saan muuta salasõna, salasõna kinnnitus peab olema ja nupp

<h1>Reset Password</h1>

<div class="row">
    <div asp-validation-summary="All" class="text-danger"></div>
    <form method="post">

        <div class="form-group">
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Confirmation"></label>
            <input asp-for="Confirmation" class="form-control" />
            <span asp-validation-for="Confirmation" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Update
        </button>
    </form>
</div>